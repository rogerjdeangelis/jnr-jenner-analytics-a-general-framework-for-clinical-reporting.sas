  304 /*--- FILL IN ALL POSSIBLE NPCT COMBINATIONS WITH 0 COUNTS FOR A LATTER JOIN         ---*/
  305 /*--- NEED A SHELL TABLE SO MISSING CATEGORIES CAN BE REPRESENTED IN THE REPORT      ---*/
  306 /*--- NOTE WE USE THE FORMAT TO GENERATE ALL COMBINATIONS                            ---*/
  307 /*--- ANSWER WILL BE THE WEIGHTS MISSING CATEGORIES WILL HAVE 0 COUNTS AND PERCENTS  ---*/
  308 /*--- WE WILL BE TAKING AVANTAGE OF POWERFULl QUESTION/ANSWER NORMAILZATION          ---*/
  309 data workx.shl;
  310  length  question  $96 trt $24;
  311  keep trt question answer;
  312  set workx.mockup(where=(scan(label,8,'@') eq 'NPCT'));      /* only categorical variables */
  313  trt="Placebo"    ; question=label; answer=0; output;
  314  trt="XL"         ; question=label; answer=0; output;
  315  trt="XH"         ; question=label; answer=0; output;
  316  trt="All"        ; question=label; answer=0; output;
  317 run;
  318 
  319 proc print data=workx.shl;
  320 run;
  321 
  322 /*--- NOTE ALL THE 0 (60 of them)
  323 Obs  question                                                                                   trt      answer
  324   1  AGEGR1N  @Page @01 @Order @210 @AGE (y)              @<65 yrs         @NPCT         @NPCT  Placebo       0
  325   2  AGEGR1N  @Page @01 @Order @210 @AGE (y)              @<65 yrs         @NPCT         @NPCT  XL            0
  326   3  AGEGR1N  @Page @01 @Order @210 @AGE (y)              @<65 yrs         @NPCT         @NPCT  XH            0
  327   4  AGEGR1N  @Page @01 @Order @210 @AGE (y)              @<65 yrs         @NPCT         @NPCT  All           0
  328 ---*/
  329 
  330 /*--- ALL NPCT ROWS HAVE JUST 1 WE WILL AD 0S LATER TO FILL IN ALL POSSIBLE COMBINATIONS ---*/
  331 proc sql;
  332  create
  333    table workx.shldat  as
  334  select
  335    coalesce(dat.trt,shl.trt)                                   as trt
  336   ,coalesce(SCAN(dat.question,1),sCAN(shl.question,1)) as grp  length=8
  337   ,coalesce(dat.question,shl.question)                         as question length=96
  338   ,coalesce(dat.answer,shl.answer)                             as answer
  339  from
  340   (select distinct * from workx.shl) as shl left join workx.nrm1st as dat
  341  on
  342   shl.question = dat.question  and
  343   shl.trt      = dat.trt
  344  order
  345   by grp, trt, question;
  346 ;quit;
  347 
  348 proc freq data=workx.shldat;
  349   tables trt;
  350 run;
