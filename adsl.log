  140    retain trt;
  141    set workx.adsl(
  142      keep=
  143        usubjid
  144        TRT01A
  145        RACEN
  146        AGE
  147        sex
  148        AGEGR1N
  149        MMSETOT
  150        EDUCLVL
  151        DURDIS
  152        WEIGHTBL
  153        HEIGHTBL
  154        BMIBL
  155        );
  156        select;
  157           when(0<durdis<12)  durdiscd=1;
  158           when(durdis=>12)   durdiscd=2;
  159          otherwise;
  160        end;
  161        select;
  162           when(0<bmibl <25)   bmicd=1;
  163           when(25<=bmibl <30) bmicd=2;
  164           when(bmibl =>30)    bmicd=3;
  165          otherwise;
  166        end;
  167        select (TRT01A);
  168          when ("Xanomeline High Dose") trt="XH";
  169          when ("Xanomeline Low Dose" ) trt="XL";
  170          when ("Placebo"             ) trt="Placebo";
  171          otherwise;
  172        end;
  173        if sex="M" then sexn=1;
  174       else if sex="F" then sexn=2;
  175     drop TRT01A sex;
  176 run;
