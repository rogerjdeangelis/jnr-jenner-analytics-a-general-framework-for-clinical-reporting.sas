 1008 /*--- CONVERT TO MS WORD ---*/
 1009 %utlfkil(D:\doc\pages.docx);
 1010 
 1011 %jnr_powershellBegin;
 1012 cards4;
 1013 $ErrorActionPreference = "Stop"
 1014 
 1015 $inputFile  = "D:\txt\adslfix.txt"
 1016 $outputFile = "D:\doc\pages.docx"
 1017 
 1018 $word  = $null
 1019 $doc   = $null
 1020 $range = $null
 1021 
 1022 try {
 1023     Write-Host "1. Checking input file..."
 1024 
 1025     if (-not (Test-Path -LiteralPath $inputFile -PathType Leaf)) {
 1026         throw "Input file not found: $inputFile"
 1027     }
 1028 
 1029     $outputDir = Split-Path -Parent $outputFile
 1030 
 1031     if (-not (Test-Path -LiteralPath $outputDir)) {
 1032         New-Item -ItemType Directory -Path $outputDir -Force |
 1033             Out-Null
 1034     }
 1035 
 1036     Write-Host "2. Reading text..."
 1037     $text = Get-Content -LiteralPath $inputFile -Raw -Encoding UTF8
 1038 
 1039     if ([string]::IsNullOrEmpty($text)) {
 1040         throw "Input file is empty: $inputFile"
 1041     }
 1042 
 1043     Write-Host "   Read $($text.Length) characters."
 1044 
 1045     Write-Host "3. Starting Microsoft Word..."
 1046     $word = New-Object -ComObject Word.Application
 1047 
 1048     $word.Visible = $true
 1049     $word.DisplayAlerts = -1
 1050 
 1051     Write-Host "4. Creating document..."
 1052     $doc = $word.Documents.Add()
 1053 
 1054     Write-Host "5. Inserting text..."
 1055     $range = $doc.Content
 1056     $range.Text = $text
 1057 
 1058     Write-Host "6. Formatting..."
 1059     $range.Font.Name = "Courier New"
 1060     $range.Font.Size = 9
 1061 
 1062     $range.ParagraphFormat.SpaceBefore = 0
 1063     $range.ParagraphFormat.SpaceAfter  = 0
 1064 
 1065     #$doc.PageSetup.Orientation  = 1
 1066     #$doc.PageSetup.TopMargin    = 36
 1067     #$doc.PageSetup.BottomMargin = 36
 1068     #$doc.PageSetup.LeftMargin   = 36
 1069     #$doc.PageSetup.RightMargin  = 36
 1070 
 1071     Write-Host "7. Saving Word document..."
 1072 
 1073     # 12 = wdFormatXMLDocument (.docx)
 1074     $doc.SaveAs2($outputFile, 12)
 1075 
 1076     if (-not (Test-Path -LiteralPath $outputFile -PathType Leaf)) {
 1077         throw "Word returned without creating the DOCX file."
 1078     }
 1079 
 1080     Write-Host "Word document exists: $outputFile"
 1081 }
 1082 catch {
 1083     Write-Host ("ERROR: " + $_.Exception.Message) -ForegroundColor Red
 1084     throw
 1085 }
 1086 finally {
 1087     if ($null -ne $range) {
 1088         [void][System.Runtime.InteropServices.Marshal]::ReleaseComObject($range)
 1089     }
 1090 
 1091     if ($null -ne $doc) {
 1092         Write-Host "8. Closing document..."
 1093         try {
 1094             $doc.Close(0)
 1095         }
 1096         catch {
 1097             Write-Warning $_.Exception.Message
 1098         }
 1099 
 1100         [void][System.Runtime.InteropServices.Marshal]::ReleaseComObject($doc)
 1101     }
 1102 
 1103     if ($null -ne $word) {
 1104         Write-Host "9. Quitting Word..."
 1105         try {
 1106             $word.Quit()
 1107         }
 1108         catch {
 1109             Write-Warning $_.Exception.Message
 1110         }
 1111 
 1112         [void][System.Runtime.InteropServices.Marshal]::ReleaseComObject($word)
 1113     }
 1114 }
 1115 Write-Host "Finished."
 1116 ;;;;
 1117 %jnr_powershellEnd;
