  372 
  373 /*--- DIMENSION VARIABLES CATEGORICAL N(PCT) VARIABLES ---*/
  374 proc sql;
  375    create
  376      table workx.cntpct as
  377    select
  378     distinct
  379      l.trt
  380     ,l.grp
  381     ,l.question
  382     ,r.sumgrp
  383     ,cats(put(sum(l.answer),4.),'(',put(sum(l.answer)/r.sumgrp,percent.),')') as answer
  384   from
  385      workx.shldat as l, (select trt, grp, sum(answer) as sumgrp from workx.shldat group by trt, grp) as r
  386   where
  387      l.trt        =  r.trt  and
  388      l.grp        =  r.grp
  389   group
  390      by l.trt, l.grp, l.question
  391 ;quit;
