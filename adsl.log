  589 /*--- COMPUTE P VALS USING PROC FTREQ ---*/
  590 %MACRO FRQX(VARS);
  591 %local i res;
  592 %let i=0;
  593 %do %until(&res= );
  594   %let i=%eval(&i + 1);
  595   %let res=%qscan(&vars,&i);
  596   %put ITER &=res &=i;
  597   Proc freq data=workx.adsl12;
  598     tables trt*&res / chisq expected;
  599   output out=&res pchi;
  600   run;
  601 %end;
