  985     savLyn = _infile_;
  986     *putlog lyn=;
  987     *--- 5 is the number of footnotes ---;
  988     do lyns = 1 to ((&psx-&footn) - lyn);
  989        put "   ";
  990        *putlog "&psx" lyn=;
  991        *putlog lyns= _infile_;
  992     end;
  993     put savlyn;
  994     lyn=-&footn;
  995   end;
  996   else do;
  997     lyn = lyn + 1;
  998     if lyn=1 then _infile_=substr(_infile_,2);
  999     put _infile_;
 1000     *putlog lyn= _infile_;
 1001   end;
